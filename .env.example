# UNISUB_LISTEN takes priority when both are set.
UNISUB_PORT=8080
# UNISUB_LISTEN=:8080
UNISUB_DB_PATH=./data/unisub.db
UNISUB_ADMIN_USERNAME=admin
# Used only when the admin table is empty. Defaults to admin when unset.
UNISUB_ADMIN_PASSWORD=admin
UNISUB_ADMIN_TOKEN_TTL=8h
# 256 MiB, matching sub2api's gateway request-body limit.
UNISUB_MAX_BODY_BYTES=268435456
# Default wait after an account reaches its concurrency limit. 0 uses the built-in 180 seconds.
UNISUB_CONCURRENCY_QUEUE_TIMEOUT_SECONDS=180
# Daily request-log table retention period. Dates use the system timezone.
UNISUB_REQUEST_LOG_RETENTION_DAYS=30
# Grok device-code OAuth defaults. Override only when xAI changes the official client contract.
UNISUB_GROK_OAUTH_ISSUER=https://auth.x.ai
UNISUB_GROK_OAUTH_CLIENT_ID=b1a00492-073a-47ea-816f-4c329264a828
UNISUB_GROK_CLIENT_VERSION=1.0.6
UNISUB_GROK_OAUTH_SCOPES="openid profile email offline_access grok-cli:access api:access conversations:read conversations:write workspaces:read workspaces:write"
# Grok Build credits endpoint. This CLI endpoint is not a versioned public API and may change upstream.
UNISUB_GROK_BILLING_URL=https://cli-chat-proxy.grok.com/v1/billing?format=credits
