{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Go: Build Server",
            "type": "process",
            "command": "go",
            "args": [
                "build",
                "-o",
                "${workspaceFolder}/bin/ai-unisub2",
                "./cmd/server"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$go"
            ]
        },
        {
            "label": "Go: Build App",
            "type": "process",
            "command": "go",
            "args": [
                "build",
                "-o",
                "${workspaceFolder}/bin/ai-unisub2-app.exe",
                "./cmd/app"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$go"
            ]
        },
        {
            "label": "Go: Test All",
            "type": "process",
            "command": "go",
            "args": [
                "test",
                "./..."
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": [
                "$go"
            ]
        }
    ]
}
