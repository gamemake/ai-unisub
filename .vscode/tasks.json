{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Web: Build",
      "type": "shell",
      "command": "npm run build",
      "windows": {
        "command": "npm.cmd run build"
      },
      "problemMatcher": []
    },
    {
      "label": "Go: Build UniSub",
      "type": "process",
      "command": "go",
      "args": [
        "build",
        "-o",
        "bin/",
        "./cmd/unisub"
      ],
      "dependsOn": "Web: Build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "Go: Test All",
      "type": "process",
      "command": "go",
      "args": [
        "test",
        "./..."
      ],
      "dependsOn": "Web: Build",
      "group": "test",
      "problemMatcher": [
        "$go"
      ]
    }
  ]
}
