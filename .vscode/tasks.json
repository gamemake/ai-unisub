{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ai-unisub: prepare build directory",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-Command",
        "New-Item -ItemType Directory -Force -Path '${workspaceFolder}/bin' | Out-Null"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "dedicated"
      }
    },
    {
      "label": "ai-unisub: build",
      "type": "process",
      "command": "go",
      "args": [
        "build",
        "-o",
        "${workspaceFolder}/bin/ai-unisub.exe",
        "./cmd/server"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "ai-unisub: prepare build directory",
      "dependsOrder": "sequence",
      "problemMatcher": [
        "$go"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "ai-unisub: test",
      "type": "process",
      "command": "go",
      "args": [
        "test",
        "-count=1",
        "./..."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$go"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "ai-unisub: vet",
      "type": "process",
      "command": "go",
      "args": [
        "vet",
        "./..."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$go"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
