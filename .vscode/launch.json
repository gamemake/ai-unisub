{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug UniSub (DEV)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/unisub",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Web: Build",
      "env": {
        "UNISUB_MODE": "DEV",
        "DATABASE_URL": "sqlite://./data/ai-unisub.db",
        "LISTEN_ADDR": "127.0.0.1:8080"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Debug OAuth CLI",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/oauth",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
